# Naver Blog Configuration
BLOG_ID=your_naver_blog_id
CATEGORY_NAME=Quatsch

# Email Alert Configuration
EMAIL_RECIPIENT=your_alert_email@gmail.com
EMAIL_SENDER=your_sender_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_if_any

# Local Directories and History (Relative to repository root or absolute)
CHROME_PROFILE_DIR=./chrome_profile
HISTORY_DIR=./history
HISTORY_FILE=./history.json
OUTPUT_DIR=./generated

# Google Drive Archiving Configuration
GOOGLE_DRIVE_FOLDER=__generated__/gemini-hobby-fantasy-scene
GOOGLE_DRIVE_LOCAL_PATH=

# Post Typography & Style Defaults (SmartEditor ONE)
POST_FONT_FAMILY=기본서체
POST_FONT_SIZE=15
POST_FONT_COLOR=색상없음
POST_ALIGN=left
POST_LINE_HEIGHT=180
